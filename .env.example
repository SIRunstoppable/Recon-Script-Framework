# Copy this file to .env and fill in your real key:
#   cp .env.example .env
#
# .env itself is git-ignored — never commit your real API key.

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - override the default model (see https://ai.google.dev/gemini-api/docs/models)
# GEMINI_MODEL=gemini-2.0-flash

# Optional - rate limiting / concurrency for every active-scanning step
# (external tools AND the Python helper scripts share these same knobs).
# RECON_RATE_LIMIT=10      # requests/sec cap, shared across all threads (0 = unlimited)
# RECON_MAX_WORKERS=15     # thread/worker count
# RECON_MAX_RETRIES=3      # retries on a 429/503 response before giving up (honors Retry-After)
